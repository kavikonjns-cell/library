# Token from @BotFather
BOT_TOKEN=123456:ABC-your-token
# Bot username without @ (used for links like t.me/<name>?start=...)
BOT_USERNAME=Kavikonj_librarybot
# Public HTTPS address of the site. Telegram mini-apps (registration form, book list) need HTTPS.
BASE_URL=https://kavikonj.example.com
# Telegram numeric ids of librarians, comma separated (ask @userinfobot for your id)
ADMIN_IDS=111111111,222222222
# Password of the web panel at /admin
ADMIN_PASSWORD=choose-a-strong-password
# Long random string for signing panel cookies
SECRET_KEY=replace-with-a-long-random-string

# Optional (defaults follow the library rules)
# LOAN_DEFAULT_DAYS=14
# LOAN_MAX_INITIAL_DAYS=14
# LOAN_MAX_TOTAL_DAYS=30
# RESERVE_HOLD_DAYS=3
# FINE_PER_DAY=50000
# FINE_MAX_DAYS=4
# REVOKE_AFTER_LATE_DAYS=5
# DAILY_JOB_HOUR=9
# CARD_NUMBER=5022291574480701
# CARD_OWNER=مرضیه زادبر، بانک پاسارگاد
# DB_PATH=data/kavikonj.db
